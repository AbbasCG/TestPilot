# Review existing VPS services and certificate paths before installing.
# HTTPS certificate must already exist. Do not run this config as-is.
server {
    listen 443 ssl;
    server_name qa.softbuild.nl;
    ssl_certificate /etc/letsencrypt/live/qa.softbuild.nl/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/qa.softbuild.nl/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    location / {
        proxy_pass http://127.0.0.1:8088;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
}
